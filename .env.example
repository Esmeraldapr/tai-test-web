# URL y clave del proyecto Supabase "TAI" (misma base de datos que el bot)
SUPABASE_URL=https://gwzzsvehzllizxdxdzhv.supabase.co
# service_role key (NO la anon key): Ajustes > API en el panel de Supabase.
# Nunca se expone al navegador, solo la usa este servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Mismas credenciales Live que ya usa bot-tai en Render (cuenta Business "Oposición TAI")
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com

# Cuenta de Gmail para el correo de vuelta a quien reporta una incidencia
# (agradecimiento + si se ha corregido o no). EMAIL_APP_PASSWORD es una
# "contraseña de aplicación" de Google (Cuenta de Google > Seguridad >
# Verificación en dos pasos > Contraseñas de aplicaciones), NO la contraseña
# normal de la cuenta.
EMAIL_USER=oposicionestaitest@gmail.com
EMAIL_APP_PASSWORD=

# Precio y URL pública una vez desplegado en Render
PRECIO_EUROS=2.50
WEBAPP_URL=https://tai-test-web.onrender.com
PORT=3000
